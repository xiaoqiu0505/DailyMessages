<Window x:Class="TodoAssistant.Views.Dialogs.BigCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日历 · DDL 总览" Width="1060" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource WinBackgroundBrush}"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：月份切换 -->
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="18,12">
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="PrevYear_Click" ToolTip="上一年" Content="«" FontSize="15" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource IconButton}" Click="PrevMonth_Click" ToolTip="上个月" Content="‹" FontSize="17" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <TextBlock x:Name="MonthTitle" Text="2026 年 11 月" FontSize="19" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0" MinWidth="150" TextAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Click="NextMonth_Click" ToolTip="下个月" Content="›" FontSize="17" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource IconButton}" Click="NextYear_Click" ToolTip="下一年" Content="»" FontSize="15" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource GhostButton}" Click="Today_Click" Content="回到今天" Margin="10,0,0,0" Padding="12,6" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource DdlBgBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="DdlCountText" Text="本月 DDL 0 个" FontSize="12"
                                   Foreground="{DynamicResource DdlTextBrush}" VerticalAlignment="Center" />
                    </Border>
                    <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="关闭" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{DynamicResource MutedBrush}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 左：月历 -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="7" Margin="0,0,0,6">
                        <TextBlock Text="周一" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" />
                        <TextBlock Text="周二" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" />
                        <TextBlock Text="周三" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" />
                        <TextBlock Text="周四" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" />
                        <TextBlock Text="周五" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" />
                        <TextBlock Text="周六" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" />
                        <TextBlock Text="周日" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" />
                    </UniformGrid>
                    <UniformGrid x:Name="CalendarGrid" Grid.Row="1" Columns="7" />
                </Grid>
            </Border>

            <!-- 右：当月 DDL 列表 -->
            <Border Grid.Column="1" Margin="14,0,0,0" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="⏳" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="本月 DDL" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DdlListPanel" />
                    </ScrollViewer>
                    <TextBlock x:Name="DdlEmptyText" Grid.Row="1" Text="本月没有 DDL"
                               FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                               TextAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
