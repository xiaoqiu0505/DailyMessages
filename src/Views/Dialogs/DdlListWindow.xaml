<Window x:Class="TodoAssistant.Views.Dialogs.DdlListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="所有 DDL" Width="560" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}" FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <TextBlock Text="所有 DDL" FontSize="16" FontWeight="SemiBold" />
            <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="Close_Click" Content="✕" />
        </Grid>

        <TextBlock Grid.Row="1" x:Name="SubtitleText" Text="" FontSize="12"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ItemsPanel" />
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="EmptyText" Text="还没有设置任何 DDL&#x000A;在添加/编辑待办时勾选「设置 DDL」即可"
                   FontSize="13" Foreground="{DynamicResource MutedBrush}"
                   TextAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />
    </Grid>
</Window>
