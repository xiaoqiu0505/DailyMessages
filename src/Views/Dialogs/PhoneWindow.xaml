<Window x:Class="TodoAssistant.Views.Dialogs.PhoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机同步与推送" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CardBrush}" FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False" UseLayoutRounding="True">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="手机同步与推送" FontSize="16" FontWeight="SemiBold" />

        <!-- 方式一：局域网网页 -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="120" Height="120" Background="{DynamicResource WinBackgroundBrush}" CornerRadius="10" VerticalAlignment="Top">
                    <Image x:Name="QrImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="方式一：同一 WiFi 下用手机浏览器打开" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="手机连上和电脑一样的 WiFi，扫左边二维码（或手动输入地址），输入 PIN 即可添加 / 勾选待办。也可“添加到主屏幕”当 App 用。"
                               FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="访问地址：" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="UrlText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Url_Click" />
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="CopyUrl_Click" Margin="6,0,0,0"
                                Content="&#xE8C8;" FontFamily="{StaticResource IconFont}" ToolTip="复制地址" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="配对 PIN：" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="PinText" Text="" FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="ResetPin_Click" Margin="6,0,0,0"
                                Content="&#xE72C;" FontFamily="{StaticResource IconFont}" ToolTip="重新生成 PIN" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="ServerStateText" Text="服务器运行中" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                        <Button Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11" Margin="10,0,0,0" Content="重启"
                                Click="RestartServer_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 方式二：ntfy 推送 -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="方式二：手机装 ntfy App，出门/不同网络也能收到提醒" FontWeight="SemiBold" FontSize="13.5" />
                <TextBlock Text="电脑会在提醒时把消息推送到 ntfy 主题，手机 ntfy App 订阅同一主题即可（有叮咚提示音 + 震动）。主题名相当于密码，不要告诉别人。"
                           FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,8" />
                <CheckBox x:Name="NtfyEnableCheck" Content="启用 ntfy 手机推送（提醒时同时推送到手机）" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="主题：" FontSize="12" VerticalAlignment="Center" />
                    <TextBox x:Name="TopicBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" FontFamily="Consolas" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="8,4" Margin="6,0,0,0" Content="随机"
                            Click="RandomTopic_Click" FontSize="11.5" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="服务器：" FontSize="12" VerticalAlignment="Center" />
                    <TextBox x:Name="ServerBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" FontFamily="Consolas"
                             ToolTip="默认 https://ntfy.sh；中国大陆可换成自建的 ntfy 服务器地址" />
                </Grid>
                <WrapPanel Margin="0,9,0,0">
                    <Button Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Margin="0,0,8,4"
                            Content="在浏览器订阅此主题" Click="OpenTopic_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12" Margin="0,0,8,4"
                            Content="发送测试推送" Click="TestPush_Click" />
                    <TextBlock x:Name="PushResultText" Text="" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </WrapPanel>
                <TextBlock Text="手机 ntfy App 里点“订阅主题” → 输入上面的主题名 → 订阅。可点“在浏览器订阅此主题”先用网页版验证。"
                           FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource GhostButton}" Content="在浏览器中打开手机版" Click="OpenUrl_Click" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="关闭" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="保存" Click="Save_Click" IsDefault="True" />
        </Grid>
    </Grid>
</Window>
