<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         浅色主题配色
         注意：所有界面都必须通过 DynamicResource 引用这些键，切换主题才能实时生效。
         ===================================================================== -->

    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2F6FE0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2560C8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#3B82F6" />

    <SolidColorBrush x:Key="WinBackgroundBrush" Color="#F6F8FC" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F8FAFE" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TextBrush" Color="#111827" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="FaintBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="LineBrush" Color="#E6EBF3" />

    <SolidColorBrush x:Key="GreenBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="RedBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="AmberBrush" Color="#F59E0B" />

    <!-- 半透明底色（状态卡片、提示条） -->
    <SolidColorBrush x:Key="SoonBgBrush" Color="#FFFCF3" />
    <SolidColorBrush x:Key="PastBgBrush" Color="#FFF8F8" />
    <SolidColorBrush x:Key="DoneBgBrush" Color="#FAFBFD" />
    <SolidColorBrush x:Key="ChipBgBrush" Color="#F1F5FB" />
    <SolidColorBrush x:Key="ChipWarnBgBrush" Color="#FFF7E6" />
    <SolidColorBrush x:Key="ChipWarnTextBrush" Color="#B45309" />
    <SolidColorBrush x:Key="HintBgBrush" Color="#F2F7FF" />
    <SolidColorBrush x:Key="HintTextBrush" Color="#3B6BB8" />
    <SolidColorBrush x:Key="InputBgBrush" Color="#F8FAFE" />
    <SolidColorBrush x:Key="SoftButtonBrush" Color="#EEF2F8" />
    <SolidColorBrush x:Key="SoftButtonHoverBrush" Color="#E1E8F4" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEECEC" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DdlBgBrush" Color="#FDF2F8" />
    <SolidColorBrush x:Key="DdlBorderBrush" Color="#F9A8D4" />
    <SolidColorBrush x:Key="DdlTextBrush" Color="#BE185D" />

</ResourceDictionary>
